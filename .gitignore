# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ===== 环境变量（含密钥，禁止提交） =====
.env
.env.local

# ===== 运行时数据（SQLite / Milvus Lite / 上传文件） =====
backend/data/*
!backend/data/.gitkeep
data/

# ===== 前端 =====
frontend/node_modules/
frontend/dist/
# 前端构建产物由 Docker 构建阶段生成并复制到 backend/static
backend/static/*
!backend/static/.gitkeep

# ===== IDE / OS =====
.vscode/
.idea/
.trae/
*.swp
.DS_Store
Thumbs.db

# ===== 离线交付临时产物 / 本机覆盖配置 =====
wheelhouse/
images/
dist/
vendor/
*.tar
*.tar.gz
docker-compose.override.yml
