# ==========================================================================
# 环境变量配置样例 — 复制为 .env 后按实际环境修改
# 本地开发：OLLAMA_BASE_URL=http://localhost:11434
# Docker 部署：OLLAMA_BASE_URL=http://ollama:11434（compose 服务名）
# 警告：.env 含敏感信息，已被 .gitignore 忽略，禁止提交
# ==========================================================================

# --- 应用基础 ---
APP_NAME=私有化RAG知识库
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# 生产部署务必修改为随机长字符串（JWT 签名密钥）
SECRET_KEY=please-change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 跨域：单端口交付时无需额外来源；本地前端开发时保留 5173
# 多个来源用 JSON 数组表示：["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Ollama 本地模型（唯一允许的模型端点，严禁指向任何外网 API） ---
# 两个模型均由 Ollama 本地提供，运行时无任何外网调用；
# 本机/容器切换不同 Ollama 地址只需改 OLLAMA_BASE_URL，代码无需改动。
OLLAMA_BASE_URL=http://ollama:11434
# 纯 CPU 冷启动首问答实测 3b 约 150s、7b 更久，默认给到 300s；GPU 环境可回调 120
OLLAMA_TIMEOUT=300
# 本地推理 LLM，默认 qwen2.5:7b（需 16GB+ 内存）；
# 纯 CPU / 内存有限的离线机建议改为 qwen2.5:3b，仅改此项即可（模型卷须含对应模型）。
LLM_MODEL=qwen2.5:7b
# 本地嵌入模型 bge-m3（Ollama 本地部署，1024 维，与 Milvus schema 对应）
# 中文/多语言能力显著优于 nomic-embed-text，8K 上下文适配长文档与表格块
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- 切片与检索参数 ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVE_TOP_K=4
# 检索命中阈值（COSINE）：bge-m3 实测校准值 0.6——相关问题 score ≥ 0.71，
# 无关问题被 0.5 完全过滤，0.6 留足余量。漏答调小（如 0.55）、乱命中调大（如 0.65）。
RETRIEVE_SCORE_THRESHOLD=0.6
# 嵌入批大小：单次 /api/embed 请求的文本条数。bge-m3 CPU 约 2-4s/条，
# 默认 16 条一批约 60s（留余量给 OLLAMA_TIMEOUT）。
# 大文件会被拆成多批后台嵌入，避免单请求超时；GPU 环境可调大到 64/128。
EMBED_BATCH_SIZE=16
# XLSX 专用块大小（字符）：表格每行是独立记录，按行累积成块，
# 既保证记录完整又把大表块数从数千压到数百，降低 CPU 嵌入耗时。
XLSX_CHUNK_SIZE=1200

# --- 数据存储（容器内路径，挂载到持久化卷） ---
DATA_DIR=/app/backend/data
# 以下三项默认基于 DATA_DIR 派生，一般无需单独设置
# SQLITE_PATH=/app/backend/data/app.db
# MILVUS_URI=/app/backend/data/milvus_rag.db
# UPLOADS_DIR=/app/backend/data/uploads

# Milvus collection：每个用户一个集合实现物理隔离，命名 user_{user_id}_rag
# 命名模板仅支持 {user_id} 占位，一般无需修改；SCHEMA_VERSION 用于兼容性自检提示
COLLECTION_NAME_TEMPLATE=user_{user_id}_rag
SCHEMA_VERSION=v1

# --- 上传限制 ---
MAX_UPLOAD_MB=50
# 允许的扩展名（JSON 数组）：pdf / docx / xlsx
# DOCX/XLSX 没有可靠页码，引用定位使用章节/工作表名，page 固定为 null
ALLOWED_EXTENSIONS=["pdf","docx","xlsx"]
